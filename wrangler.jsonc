{
  "name": "gearbox",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
